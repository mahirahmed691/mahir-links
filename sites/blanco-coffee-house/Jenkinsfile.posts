// Public posts for Blanco Coffee House, written as a Coffee shop. Paste them yourself.
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  stages {
    stage('Write the week of posts') {
      steps {
        writeFile file: 'site-status/content-request.json', text: "{\"niche\":\"Coffee shop\"}"
        dir('site-status') {
          sh 'node --version'
          sh 'node scripts/content.mjs content-request.json content'
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: 'site-status/content/*.txt', onlyIfSuccessful: true
    }
    cleanup {
      sh 'rm -rf site-status/content site-status/content-request.json'
    }
  }
}
